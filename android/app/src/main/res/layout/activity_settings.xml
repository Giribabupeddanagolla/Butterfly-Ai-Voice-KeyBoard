<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🦋 Butterfly AI Voice Keyboard Settings"
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure host PC FastAPI backend URL & system keyboard"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- BACKEND SERVER URL SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FastAPI Backend Server URL (LAN IP)"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Run 'python app.py' on PC and enter your Wi-Fi IP address (e.g. http://192.168.1.105:8000)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/backend_url_hint"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@color/bg_card"
            android:paddingHorizontal="16dp"
            android:inputType="textUri"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnSaveUrl"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Save URL"
                android:textColor="@color/bg_dark"
                android:backgroundTint="@color/primary"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnTestConnection"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Test Connection"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/bg_key"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke_card"
            android:layout_marginBottom="16dp" />

        <!-- KEYBOARD ACTIVATION STEPS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable & Select System Keyboard"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEnableIme"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="1. Enable Butterfly AI Keyboard in Android Settings"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/bg_card"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSelectIme"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="2. Select Butterfly AI Keyboard as Active Input Method"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/bg_card"
            android:gravity="start|center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
