<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TITLE HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/imgSettingsLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_butterfly_logo_bitmap"
                android:contentDescription="Logo"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Butterfly AI Voice Keyboard"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings &amp; Server Connection"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 1: BACKEND SERVER URL SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_voice"
            android:backgroundTint="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 Butterfly AI Cloud Server URL"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connected to 24/7 Cloud Backend. No PC or Wi-Fi setup needed!"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="https://butterfly-ai-voice-keyboard.onrender.com"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:background="@drawable/bg_search_bar"
                android:backgroundTint="#0F172A"
                android:paddingHorizontal="14dp"
                android:inputType="textUri"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveUrl"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Save Server URL"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_keycap_enter_blue"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnTestConnection"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Test Connection"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_quick_toolbar_pill"
                    android:backgroundTint="#334155"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTestResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- CARD 2: KEYBOARD VISUAL THEME SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_search"
            android:backgroundTint="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 Mobile Keyboard Visual Theme"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose your preferred high-contrast color scheme"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <Spinner
                android:id="@+id/spinnerKeyboardTheme"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:dropDownHeight="160dp"
                android:background="@drawable/bg_lang_pill"
                android:backgroundTint="#0F172A"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- CARD 2B: KEYBOARD TYPING PREFERENCES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ai"
            android:backgroundTint="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Typing &amp; Feedback Preferences"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Haptic Vibration Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vibration on Keypress"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tactile haptic feedback when typing"
                        android:textColor="#94A3B8"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchHapticFeedback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Double-Tap Space for Period Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Double-tap Space for Period"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inserts a period and space ('. ')"
                        android:textColor="#94A3B8"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDoubleSpacePeriod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 3: KEYBOARD ACTIVATION STEPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ai"
            android:backgroundTint="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌨ Enable &amp; Select System Keyboard"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Dynamic IME Status Badge -->
            <TextView
                android:id="@+id/tvImeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Checking Keyboard Status..."
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnEnableIme"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="1. Enable Keyboard in Android Settings ➔"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_keycap_enter_blue"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnSelectIme"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="2. Select Butterfly AI as Active Keyboard ➔"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_quick_toolbar_pill"
                android:backgroundTint="#059669"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <!-- CARD 4: MICROPHONE PERMISSION SECTION -->
        <LinearLayout
            android:id="@+id/cardMicPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_voice"
            android:backgroundTint="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ Microphone Permission"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Required for voice recording, speech-to-text, and live translation."
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <!-- Dynamic Microphone Permission Status -->
            <TextView
                android:id="@+id/tvMicStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="● Checking microphone status..."
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGrantMicPermission"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Grant Mic Permission"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_keycap_enter_blue"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnOpenAppSettings"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="Open Settings"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_quick_toolbar_pill"
                    android:backgroundTint="#334155"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 5: HISTORY & CONVERSATIONS SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_search"
            android:backgroundTint="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 Voice &amp; Translation History"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View, copy, and manage your voice recordings, translations, and conversations."
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnOpenHistory"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Open Conversation History ➔"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_quick_toolbar_pill"
                android:backgroundTint="#2563EB"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <!-- CARD 6: CUSTOM SNIPPETS & VOICE SHORTCUTS SECTION -->
        <LinearLayout
            android:id="@+id/cardSnippetsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_voice"
            android:backgroundTint="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝 Custom Snippets &amp; Quick Text"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add templates and voice triggers to insert instantly with the 📝 keyboard button."
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <!-- New Snippet Inputs -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snippet Name"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etSnippetName"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="e.g. My Email, Work Address, Quick Greeting"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:background="@drawable/bg_search_bar"
                android:backgroundTint="#0F172A"
                android:paddingHorizontal="12dp"
                android:inputType="textCapWords"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snippet Content (Text to Insert)"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etSnippetText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:hint="Type or paste the full text template here..."
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:background="@drawable/bg_search_bar"
                android:backgroundTint="#0F172A"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voice Shortcut Trigger (Optional)"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etSnippetTrigger"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="e.g. 'my email' or 'greeting'"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:background="@drawable/bg_search_bar"
                android:backgroundTint="#0F172A"
                android:paddingHorizontal="12dp"
                android:inputType="text"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <!-- Buttons: Add Snippet & Reset Defaults -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/btnAddSnippet"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="+ Add Snippet"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_quick_toolbar_pill"
                    android:backgroundTint="#2563EB"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnResetSnippets"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="↺ Defaults"
                    android:textAllCaps="false"
                    android:textColor="#CBD5E1"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_quick_toolbar_pill"
                    android:backgroundTint="#334155"
                    android:paddingHorizontal="14dp" />
            </LinearLayout>

            <!-- Status Notice -->
            <TextView
                android:id="@+id/tvSettingsSnippetsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading snippets..."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <!-- Dynamic Snippets List -->
            <LinearLayout
                android:id="@+id/layoutSettingsSnippetsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- CARD 6: ABOUT & SYSTEM INFO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ai"
            android:backgroundTint="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️ About Butterfly AI Keyboard"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.0.0 (Build 1) • Multilingual Voice AI IME"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCheckUpdates"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Check for Latest Releases ➔"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_quick_toolbar_pill"
                android:backgroundTint="#334155"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
